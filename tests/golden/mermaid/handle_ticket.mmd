flowchart TD
    start([handle_ticket])
    triage[triage]
    start --> triage
    branch_0{branch}
    triage --> branch_0
    subgraph refund_sub [refund]
    refund_start((refund))
    refund_refunder[[refunder ⏸]]
    refund_start --> refund_refunder
    end
    branch_0 -->|arm 0| refund_start
    subgraph answer_sub [answer]
    answer_start((answer))
    answer_parallel_order_faq_fork[/parallel_order_faq/]
    answer_start --> answer_parallel_order_faq_fork
    answer_parallel_order_faq_join[\join\]
    answer_parallel_order_faq_order[fetch_order]
    answer_parallel_order_faq_fork --> answer_parallel_order_faq_order
    answer_parallel_order_faq_order --> answer_parallel_order_faq_join
    answer_parallel_order_faq_faq[search_faq]
    answer_parallel_order_faq_fork --> answer_parallel_order_faq_faq
    answer_parallel_order_faq_faq --> answer_parallel_order_faq_join
    answer_draft_reply[draft_reply]
    answer_parallel_order_faq_join --> answer_draft_reply
    subgraph answer_loop_revise_reply_sub [loop_revise_reply]
    answer_loop_revise_reply_start((loop))
    answer_loop_revise_reply_revise_reply[revise_reply]
    answer_loop_revise_reply_start --> answer_loop_revise_reply_revise_reply
    end
    answer_draft_reply --> answer_loop_revise_reply_start
    answer_loop_revise_reply_revise_reply -.->|repeat, max 3| answer_loop_revise_reply_start
    answer_answer[answer]
    answer_loop_revise_reply_revise_reply --> answer_answer
    end
    branch_0 -->|otherwise| answer_start
    notify_customer[notify_customer]
    refund_refunder --> notify_customer
    answer_answer --> notify_customer
    notify_customer --> finish([end])
